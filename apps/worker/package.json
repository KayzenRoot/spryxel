{
  "name": "@spryxel/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./queue-probe": {
      "types": "./dist/queue-probe.d.ts",
      "import": "./dist/queue-probe.js"
    },
    "./durable-jobs": {
      "types": "./dist/durable-jobs.d.ts",
      "import": "./dist/durable-jobs.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@spryxel/config": "0.0.0",
    "@spryxel/db": "0.0.0",
    "@spryxel/domain": "0.0.0",
    "@spryxel/observability": "0.0.0",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0"
  }
}
