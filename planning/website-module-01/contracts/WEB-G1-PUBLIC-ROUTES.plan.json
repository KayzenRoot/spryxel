        "/es/legal/cookies"
      ]
    }
  ],
  "existingProtectedRoutes": [
    "/",
    "/projects",
    "/projects/[projectId]",
    "/account"
  ],
  "existingAuthRoutes": [
    "/sign-in",
    "/sign-out",
    "/auth/callback"
  ],
  "localeSwitch": {
    "routeKeyBased": true,
    "unknownTranslation": "choose known published base locale route only",
    "anchorPreservation": "preserve hash if supported and target anchor exists",
    "hrefAudit": "no fabricated profile/terms/contact hrefs"
  },
  "sharedComponents": {
    "headerOwner": "A5",
    "footerOwner": "A5",
    "masterLayoutOwner": "B1",
    "i18nOwner": "A6",
    "seoOwner": "A4",
    "contentOwner": "A6",
    "consentOwner": "A2",
    "authEntryOwner": "A7",
    "heroOwner": "A1",
    "heroArtOwner": "A3"
  },
  "authSecurity": {
    "WorkOS": "retain current authkit",
    "existingRootRequiresSession": true,
    "forbidSensitivePublicData": true,
    "crossTenantTestsNeededAtCutover": true,
    "proxyChangeRisk": "HIGH_ASSURANCE",
    "noRealCustomAuthForm": true
  },
  "blockedUntilApproved": [
    "G0 decision #63",
    "G1 contract #64",
    "G2 master #70/#53",
    "public legal identity and counsel review",
