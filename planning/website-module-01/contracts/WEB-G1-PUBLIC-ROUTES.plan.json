{
  "schemaVersion": "SPRYXEL_WEB_G1_PUBLIC_ROUTE_PLAN_V1",
  "status": "PROPOSED_NOT_ADMITTED",
  "localeStrategy": {
    "canonical": "en",
    "supported": [
      "en",
      "pt-BR",
      "es"
    ],
    "localePathSegment": true,
    "caseSensitivePath": true,
    "unknownLocalePolicy": "404 or explicit safe redirect after G1 decision, no hidden auth fallback",
    "translationKeyOwner": "A6",
    "localeCookie": "optional presentation preference, consent/retention gate applies",
    "seo": {
      "defaultLocaleHref": "/en",
      "hreflang": [
        "en",
        "pt-BR",
        "es",
        "x-default"
      ],
      "preRelease": "noindex unless public publish criteria passed",
      "metadataOwner": "A4"
    }
  },
  "stages": [
    {
      "name": "A-additive",
      "root": {
        "path": "/",
        "type": "EXISTING_PROTECTED_COMMAND_CENTER",
        "keepUntouched": true
      },
      "publicRoot": {
        "path": "/en",
        "type": "NEW_PUBLIC_MARKETING_ROUTE"
      },
      "workspaceHome": {
        "path": "/",
        "type": "EXISTING",
        "keepUntouched": true
      },
      "authentication": {
        "signInPath": "/sign-in",
        "workosExisting": true,
        "signInReturnTo": "/account"
      },
      "proxyRule": "Protect original / and original account/projects; new explicit public /<locale> should not inherit protected matcher"
    },
    {
      "name": "B-root-cutover",
      "status": "SEPARATE_HIGH_ASSURANCE_DECISION",
      "root": {
        "path": "/",
        "type": "PUBLIC_DEFAULT_LOCALE_REDIRECT_OR_LANDING",
        "pendingDecision": true
      },
      "workspaceHome": {
        "path": "/app",
        "type": "CANDIDATE_PROTECTED_DESTINATION",
        "pendingDecision": true
      },
      "requiredMigration": [
        "apps/web/app/page.tsx",
        "apps/web/app/components/global-shell.tsx",
        "apps/web/proxy.ts",
        "apps/web/app/sign-in/route.ts only if actual returnTo changes",
        "apps/web/app/page.spec.ts",
        "shared metadata/canonical and all hrefs"
      ],
      "rollback": "keep additive /en public if protected root cannot be safely migrated"
    }
  ],
  "additivePublicRoutes": [
    {
      "key": "home",
      "slug": "",
      "view": "PublicLanding",
      "owner": "A1+B1",
      "publishGate": "G2_VISUAL_OWNER_APPROVAL",
      "indexableWhenApproved": true,
      "urls": [
        "/en",
        "/pt-BR",
        "/es"
      ]
    },
    {
      "key": "features",
      "slug": "features",
      "view": "AssetTypes",
      "owner": "A1+B1",
      "publishGate": "CONTENT_TRUTH",
      "indexableWhenApproved": true,
      "urls": [
        "/en/features",
        "/pt-BR/features",
