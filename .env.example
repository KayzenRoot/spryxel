# Copy variable names into a local environment file. Never add credentials here.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# DATABASE_URL uses the normal application login role (NOBYPASSRLS).
DATABASE_URL=
# MIGRATION_DATABASE_URL is for explicit migration/status commands only.
MIGRATION_DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_ISSUER=
WORKOS_TOKEN_AUDIENCE=https://api.spryxel.example
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:3100/auth/callback
